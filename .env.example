DATABASE_URL=
DATABASE_PUBLIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
STT_LANGUAGE=es

# FASE 6A: optional embeddings; dimension must match the model native output
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_EMBEDDING_DIMENSIONS=2560
MEMORY_AUTO_INDEX=false
MEMORY_CHUNK_VERSION=paragraph-v1
MEMORY_CHUNK_SIZE=6000
MEMORY_CHUNK_OVERLAP=350
EXTRACTION_MAX_CHARS=30000

# Adaptive retrieval and resumable long-source extraction
REASONING_CONTEXT_MAX_CHARS=100000
HIERARCHICAL_EXTRACTION_ENABLED=true
HIERARCHICAL_MAX_CHUNKS=40
HIERARCHICAL_PART_MAX_TOKENS=4096
HIERARCHICAL_CONSOLIDATION_MAX_ITEMS=300
HIERARCHICAL_CONSOLIDATION_MAX_CHARS=160000
HIERARCHICAL_CONSOLIDATION_MAX_TOKENS=12000

# Versioned Project Memory; updates call Claude only for changed/explicit projects
PROJECT_MEMORY_ENABLED=true
PROJECT_MEMORY_DEBOUNCE_SECONDS=300
PROJECT_MEMORY_MAX_CHARS=12000
PROJECT_MEMORY_INCREMENTAL_MAX_SOURCES=20
PROJECT_MEMORY_RECONCILIATION_HOUR=3
PROJECT_MEMORY_TIMEZONE=America/Lima

# Telegram TXT/MD; procesamiento persistente fuera de la recepcion
TELEGRAM_DOCUMENT_MAX_BYTES=20971520
SOURCE_PROCESSING_WORKER_ENABLED=true
